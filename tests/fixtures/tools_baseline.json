                "sets": {
                  "description": "Sets in the exercise",
                  "items": {
                    "properties": {
                      "custom_metric": {
                        "description": "Custom metric value",
                        "type": "number"
                      },
                      "distance_meters": {
                        "description": "Distance in meters",
                        "type": "number"
                      },
                      "duration_seconds": {
                        "description": "Duration in seconds",
                        "type": "number"
                      },
                      "reps": {
                        "description": "Number of reps",
                        "type": "number"
                      },
                      "rpe": {
                        "description": "Rate of perceived exertion (1-10)",
                        "type": "number"
                      },
                      "set_type": {
                        "description": "Type of set",
                        "enum": [
                          "normal",
                          "warmup",
                          "dropset",
                          "failure"
                        ],
                        "type": "string"
                      },
                      "weight_kg": {
                        "description": "Weight in kg",
                        "type": "number"
                      }
                    },
                    "required": [
                      "set_type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "superset_id": {
                  "description": "Superset group ID",
                  "type": "number"
                }
              },
              "required": [
                "exercise_template_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "description": "The workout ID to update",
            "type": "string"
          },
          "is_private": {
            "description": "Whether the workout is private",
            "type": "boolean"
          },
          "start_time": {
            "description": "Start time in ISO 8601 format",
            "type": "string"
          },
          "title": {
            "description": "Workout title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "start_time",
          "end_time"
        ],
        "type": "object"
      },
      "name": "update_workout"
    },
    {
      "description": "List workout routines from Hevy with pagination. Routines are workout templates you can start workouts from.",
      "inputSchema": {
        "properties": {
          "page": {
            "description": "Page number (1-indexed)",
            "type": "number"
          },
          "page_size": {
            "description": "Number of items per page (max 10)",
            "type": "number"
          }
        },
        "type": "object"
      },
      "name": "get_routines"
    },
    {
      "description": "Get a single routine by its ID. Returns full routine details including all exercises and set templates.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "The routine ID",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "get_routine"
    },
    {
      "description": "Create a new workout routine in Hevy. Routines serve as templates for workouts.",
      "inputSchema": {
        "properties": {
          "exercises": {
            "description": "Exercises in the routine",
            "items": {
              "properties": {
                "exercise_template_id": {
                  "description": "Exercise template ID",
                  "type": "string"
                },
                "notes": {
                  "description": "Exercise notes",
                  "type": "string"
                },
                "rest_seconds": {
                  "description": "Rest time between sets in seconds",
                  "type": "number"
                },
                "sets": {
                  "description": "Set templates in the exercise",
                  "items": {
                    "properties": {
                      "custom_metric": {
                        "description": "Custom metric value",
                        "type": "number"
                      },
                      "distance_meters": {
                        "description": "Distance in meters",
                        "type": "number"
                      },
                      "duration_seconds": {
                        "description": "Duration in seconds",
                        "type": "number"
                      },
                      "rep_range": {
                        "description": "Rep range for the set",
                        "properties": {
                          "end": {
                            "description": "Max reps",
                            "type": "number"
                          },
                          "start": {
                            "description": "Min reps",
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "reps": {
                        "description": "Number of reps",
                        "type": "number"
                      },
                      "set_type": {
                        "description": "Type of set",
                        "enum": [
                          "normal",
                          "warmup",
                          "dropset",
                          "failure"
                        ],
                        "type": "string"
                      },
                      "weight_kg": {
                        "description": "Weight in kg",
                        "type": "number"
                      }
                    },
                    "required": [
                      "set_type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "superset_id": {
                  "description": "Superset group ID",
                  "type": "number"
                }
              },
              "required": [
                "exercise_template_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "folder_id": {
            "description": "Folder ID to place the routine in (use get_routine_folders to list available folders)",
            "type": "string"
          },
          "notes": {
            "description": "Optional notes",
            "type": "string"
          },
          "title": {
            "description": "Routine title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "folder_id"
        ],
        "type": "object"
      },
