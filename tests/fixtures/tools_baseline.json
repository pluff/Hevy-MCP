    {
      "description": "List exercise templates from Hevy's exercise library. These are the exercises you can add to workouts and routines.",
      "inputSchema": {
        "properties": {
          "page": {
            "description": "Page number (1-indexed)",
            "type": "number"
          },
          "page_size": {
            "description": "Number of items per page (max 100)",
            "type": "number"
          }
        },
        "type": "object"
      },
      "name": "get_exercise_templates"
    },
    {
      "description": "Get a single exercise template by its ID. Returns exercise details including muscle groups and equipment.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "The exercise template ID",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "get_exercise_template"
    },
    {
      "description": "Create a new custom exercise template.",
      "inputSchema": {
        "properties": {
          "equipment_category": {
            "description": "Equipment category",
            "enum": [
              "barbell",
              "dumbbell",
              "machine",
              "cable",
              "bodyweight",
              "band",
              "kettlebell",
              "trap_bar",
              "smith_machine",
              "other"
            ],
            "type": "string"
          },
          "exercise_type": {
            "description": "Exercise type",
            "enum": [
              "weight_reps",
              "reps",
              "duration",
              "weight_duration",
              "distance_duration",
              "weight"
            ],
            "type": "string"
          },
          "muscle_group": {
            "description": "Primary muscle group",
            "enum": [
              "abdominals",
              "abductors",
              "adductors",
              "biceps",
              "calves",
              "cardio",
              "chest",
              "forearms",
              "full_body",
              "glutes",
              "hamstrings",
              "lats",
              "lower_back",
              "neck",
              "quadriceps",
              "shoulders",
              "traps",
              "triceps",
              "upper_back",
              "other"
            ],
            "type": "string"
          },
          "other_muscles": {
            "description": "Optional additional muscle groups",
            "items": {
              "enum": [
                "abdominals",
                "abductors",
                "adductors",
                "biceps",
                "calves",
                "cardio",
                "chest",
                "forearms",
                "full_body",
                "glutes",
                "hamstrings",
                "lats",
                "lower_back",
                "neck",
                "quadriceps",
                "shoulders",
                "traps",
                "triceps",
                "upper_back",
                "other"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "Exercise title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "exercise_type",
          "equipment_category",
          "muscle_group"
        ],
        "type": "object"
      },
      "name": "create_exercise_template"
    },
    {
      "description": "Get exercise history for a specific exercise template.",
      "inputSchema": {
        "properties": {
          "end_date": {
            "description": "Optional ISO 8601 end date",
            "type": "string"
          },
          "exercise_template_id": {
            "description": "Exercise template ID",
            "type": "string"
          },
          "start_date": {
            "description": "Optional ISO 8601 start date",
            "type": "string"
          }
        },
        "required": [
          "exercise_template_id"
        ],
        "type": "object"
      },
      "name": "get_exercise_history"
    },
