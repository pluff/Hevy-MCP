{
  "tools": [
    {
      "description": "List workouts from Hevy with pagination. Returns workout summaries including title, date, and exercises.",
      "inputSchema": {
        "properties": {
          "page": {
            "description": "Page number (1-indexed)",
            "type": "number"
          },
          "page_size": {
            "description": "Number of items per page (max 10)",
            "type": "number"
          }
        },
        "type": "object"
      },
      "name": "get_workouts"
    },
    {
      "description": "Get the total number of workouts on the account.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "get_workouts_count"
    },
    {
      "description": "List workout update and delete events since a given date, with pagination.",
      "inputSchema": {
        "properties": {
          "page": {
            "description": "Page number (1-indexed)",
            "type": "number"
          },
          "page_size": {
            "description": "Number of items per page (max 10)",
            "type": "number"
          },
          "since": {
            "description": "ISO 8601 timestamp to start from",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "get_workout_events"
    },
    {
      "description": "Get a single workout by its ID. Returns full workout details including all exercises and sets.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "The workout ID",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "get_workout"
    },
    {
      "description": "Create a new workout in Hevy. Requires title, start_time, end_time (ISO 8601), and exercises with sets.",
      "inputSchema": {
        "properties": {
          "description": {
            "description": "Optional description",
            "type": "string"
          },
          "end_time": {
            "description": "End time in ISO 8601 format",
            "type": "string"
          },
          "exercises": {
            "description": "Exercises in the workout",
            "items": {
              "properties": {
                "exercise_template_id": {
                  "description": "Exercise template ID",
                  "type": "string"
                },
                "notes": {
                  "description": "Exercise notes",
                  "type": "string"
                },
                "sets": {
                  "description": "Sets in the exercise",
                  "items": {
                    "properties": {
                      "custom_metric": {
                        "description": "Custom metric value",
                        "type": "number"
                      },
                      "distance_meters": {
                        "description": "Distance in meters",
                        "type": "number"
                      },
                      "duration_seconds": {
                        "description": "Duration in seconds",
                        "type": "number"
                      },
                      "reps": {
                        "description": "Number of reps",
                        "type": "number"
                      },
                      "rpe": {
                        "description": "Rate of perceived exertion (1-10)",
                        "type": "number"
                      },
                      "set_type": {
                        "description": "Type of set",
                        "enum": [
                          "normal",
                          "warmup",
                          "dropset",
                          "failure"
                        ],
                        "type": "string"
                      },
                      "weight_kg": {
                        "description": "Weight in kg",
                        "type": "number"
                      }
                    },
                    "required": [
                      "set_type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "superset_id": {
                  "description": "Superset group ID",
                  "type": "number"
                }
              },
              "required": [
                "exercise_template_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "is_private": {
            "description": "Whether the workout is private",
            "type": "boolean"
          },
          "start_time": {
            "description": "Start time in ISO 8601 format",
            "type": "string"
          },
          "title": {
            "description": "Workout title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "start_time",
          "end_time"
        ],
        "type": "object"
      },
      "name": "create_workout"
    },
    {
